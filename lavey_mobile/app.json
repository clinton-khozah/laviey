{
  "expo": {
    "name": "Lavey",
    "slug": "lavey-mobile",
    "scheme": "lavieymobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-heart-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.brightbyte.lavey",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lavey uses your location to show relevant people nearby.",
        "NSPhotoLibraryUsageDescription": "Lavey needs photo access so you can update your profile pictures.",
        "NSCameraUsageDescription": "Lavey needs camera access for video calls and profile verification.",
        "NSMicrophoneUsageDescription": "Lavey needs microphone access for voice and video calls.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F7FB",
        "foregroundImage": "./assets/app-heart-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "za.co.brightbyte.lavey",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 10
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.17132674984-klaq75k8d7k6kc0ke76d0dhp85bor8hd"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-navigation-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lavey to access your photos so you can update your profile."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Lavey to use your location to find relevant people nearby."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/heart-tight.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/heart-tight.png"
          }
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/app-heart-icon.png",
          "color": "#FF5271",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b3809907-3634-4825-8592-c25e8850322d"
      }
    },
    "owner": "clinton48"
  }
}
